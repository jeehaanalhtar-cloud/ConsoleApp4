using System;
consoleApp
class Program
{
    static void Main()
    {
        Console.WriteLine("=== Number Challenge (1 to 20) ===");

        for (int i = 1; i <= 20; i++)
        {
            if (i == 15)
            {
                Console.WriteLine("Reached 15 -> Stopping loop (break).");
                break;
            }

            if (i % 2 == 0)
            {
                continue;
            }

            Console.WriteLine(i);
        }
    }
}
